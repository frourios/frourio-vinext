{
  "name": "@frourio/vinext",
  "version": "0.0.0",
  "description": "Vinext Route Handlers helper with runtime validation and type-safe clients",
  "author": "Solufa",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "bin": {
    "frourio-vinext": "bin/index.js",
    "frourio-vinext-msw": "bin/msw.js",
    "frourio-vinext-openapi": "bin/openapi.js"
  },
  "scripts": {
    "dev": "npm run build && npm run generate",
    "generate": "node projects/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://github.com/frouriojs/frourio-vinext#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/frourios/frourio-vinext"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "vinext",
    "frourio"
  ],
  "dependencies": {
    "chokidar": "^5.0.0",
    "minimist": "^1.2.8",
    "openapi-types": "^12.1.3",
    "typescript-json-schema": "^0.67.1"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@frourio/vinext": "file:.",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/minimist": "^1.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ai": "^6.0.116",
    "cookie": "^1.1.1",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "swr": "^2.4.1",
    "typescript": "^6.0.2",
    "vinext": "1.0.0-beta.9",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  }
}
